<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:colorAccent">#B3A0FF</item>
    <item name="android:colorBackground">#15141b</item>
    <item name="android:colorBackgroundFloating">#1c1b24</item>
    <item name="android:textColorPrimary">#f4f2f8</item>
    <item name="android:textColorSecondary">#a7a3b6</item>
    <item name="android:windowBackground">#15141b</item>
    <item name="android:navigationBarColor">#15141b</item>
    <item name="android:statusBarColor">#15141b</item>
    <item name="android:editTextStyle">@style/AppEditText</item>
    <item name="android:alertDialogTheme">@style/AppDialog</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowActionModeOverlay">true</item>
  </style>
  <style name="AppDialog" parent="android:style/Theme.Material.Dialog.Alert">
    <item name="android:windowBackground">@drawable/dialog_background</item>
    <item name="android:colorAccent">#B3A0FF</item>
    <item name="android:colorBackground">#1c1b24</item>
    <item name="android:textColorPrimary">#f4f2f8</item>
    <item name="android:textColorSecondary">#a7a3b6</item>
    <item name="android:editTextStyle">@style/AppEditText</item>
    <item name="android:backgroundDimAmount">0.65</item>
    <item name="android:fontFamily">sans</item>
  </style>
  <style name="AppEditText" parent="android:style/Widget.Material.EditText">
    <item name="android:background">@drawable/field_background</item>
    <item name="android:textColor">#f4f2f8</item>
    <item name="android:textColorHint">#a7a3b6</item>
    <item name="android:textSize">14sp</item>
    <item name="android:minHeight">46dp</item>
    <item name="android:paddingLeft">14dp</item>
    <item name="android:paddingRight">14dp</item>
  </style>
</resources>
